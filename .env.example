# Copy this file to .env. Do not commit the real .env file.
# Supabase dashboard: Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard: Project Settings -> API -> Publishable key.
# If the dashboard only shows a legacy anon key, use that value here instead.
# Never use a service_role or secret key in an Expo app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key
